# Build the backend outside production; frontend dist is built and checked first.
FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine3.24 AS toolchain
FROM --platform=$BUILDPLATFORM debian:trixie-slim AS backend
COPY --from=toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}" GOTOOLCHAIN=local GOMEMLIMIT=384MiB GOMAXPROCS=2
RUN test -s /usr/local/go/bin/go && go version
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git gcc-x86-64-linux-gnu libc6-dev-amd64-cross && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY ezbookkeeping.go ./
COPY cmd ./cmd
COPY pkg ./pkg
ARG COMMIT_HASH=unknown
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 GOOS=linux GOARCH=amd64 CC=x86_64-linux-gnu-gcc go build -p 2 -trimpath -ldflags "-w -s -linkmode external -extldflags '-static' -X main.Version=2.2.0 -X main.CommitHash=${COMMIT_HASH}" -o /ezbookkeeping ezbookkeeping.go
FROM alpine:3.24.3
RUN apk add --no-cache tzdata ca-certificates && addgroup -g 1000 -S ezbookkeeping && adduser -S -u 1000 -G ezbookkeeping ezbookkeeping
WORKDIR /ezbookkeeping
COPY --from=backend /ezbookkeeping ./ezbookkeeping
COPY dist ./public
COPY conf ./conf
COPY templates ./templates
COPY LICENSE ./LICENSE
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN mkdir -p data storage log && chown -R 1000:1000 /ezbookkeeping && chmod +x /docker-entrypoint.sh
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.sh"]
