# Build the backend outside production; frontend dist is built and checked first.
FROM golang:1.27.3-alpine3.24 AS backend
RUN apk add --no-cache gcc musl-dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY ezbookkeeping.go ./
COPY cmd ./cmd
COPY pkg ./pkg
ARG COMMIT_HASH=unknown
RUN CGO_ENABLED=1 go build -p 2 -trimpath -ldflags "-w -s -X main.Version=2.2.0-chat -X main.CommitHash=${COMMIT_HASH}" -o /ezbookkeeping ezbookkeeping.go
FROM alpine:3.24.3
RUN apk add --no-cache tzdata ca-certificates && addgroup -g 1000 -S ezbookkeeping && adduser -S -u 1000 -G ezbookkeeping ezbookkeeping
WORKDIR /ezbookkeeping
COPY --from=backend /ezbookkeeping ./ezbookkeeping
COPY dist ./public
COPY conf ./conf
COPY templates ./templates
COPY LICENSE ./LICENSE
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN mkdir -p data storage log && chown -R 1000:1000 /ezbookkeeping && chmod +x /docker-entrypoint.sh
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.sh"]
